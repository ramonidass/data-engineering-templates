terraform {
  required_version = ">= 1.9.0"

  required_providers {
{% if cloud == 'gcp' %}
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
{% elif cloud == 'aws' %}
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
{% elif cloud == 'azure' %}
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.0"
    }
{% endif %}
  }

{% if cloud == 'gcp' %}
  backend "gcs" {}
{% elif cloud == 'aws' %}
  backend "s3" {}
{% elif cloud == 'azure' %}
  backend "azurerm" {}
{% endif %}
}

{% if cloud == 'gcp' %}
provider "google" {
  project = var.project_id
  region  = var.region
}
{% elif cloud == 'aws' %}
provider "aws" {
  region = var.region

  default_tags {
    tags = local.common_tags
  }
}
{% elif cloud == 'azure' %}
provider "azurerm" {
  features {}
}
{% endif %}

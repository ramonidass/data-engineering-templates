version: 2

sources:
  - name: raw
    description: Landing zone for {{ product_name_display }} source data.
    # DuckDB points at the bundled seed so the starter runs end-to-end locally.
    # Other adapters use the expected raw landing schema.
{% if adapter == 'duckdb' %}
    schema: main
{% else %}
    schema: raw
{% endif %}
    tables:
      - name: example_events
        description: Replace with your first real source table.
        columns:
          - name: id
            description: Primary key of the event.
          - name: occurred_at
            description: Event timestamp (UTC).

"""Example CRUD router backed by an in-memory store.

Replace the dict with a real repository (database, warehouse, bucket) and
delete this docstring. The pattern to keep: routers stay thin, validation
lives in schemas, storage lives behind a small interface.
"""

from typing import Annotated, cast
from uuid import UUID

from fastapi import APIRouter, Depends, HTTPException, Query, Request, status

from {{ package_name }}.repositories import ItemRepository
from {{ package_name }}.schemas import Item, ItemCreate

router = APIRouter(prefix="/items", tags=["items"])


async def get_item_repository(request: Request) -> ItemRepository:
    return cast(ItemRepository, request.app.state.item_repository)


Repository = Annotated[ItemRepository, Depends(get_item_repository)]


@router.post("", status_code=status.HTTP_201_CREATED)
async def create_item(payload: ItemCreate, repository: Repository) -> Item:
    return repository.create(payload)


@router.get("")
async def list_items(
    repository: Repository,
    offset: Annotated[int, Query(ge=0)] = 0,
    limit: Annotated[int, Query(ge=1, le=100)] = 50,
) -> list[Item]:
    return repository.list_items(offset=offset, limit=limit)


@router.get("/{item_id}")
async def get_item(item_id: UUID, repository: Repository) -> Item:
    item = repository.get(item_id)
    if item is None:
        raise HTTPException(status.HTTP_404_NOT_FOUND, detail="item not found")
    return item


@router.delete("/{item_id}", status_code=status.HTTP_204_NO_CONTENT)
async def delete_item(item_id: UUID, repository: Repository) -> None:
    if not repository.delete(item_id):
        raise HTTPException(status.HTTP_404_NOT_FOUND, detail="item not found")

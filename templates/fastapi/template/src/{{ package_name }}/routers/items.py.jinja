"""Example CRUD router backed by an in-memory store.

Replace the dict with a real repository (database, warehouse, bucket) and
delete this docstring. The pattern to keep: routers stay thin, validation
lives in schemas, storage lives behind a small interface.
"""

from uuid import UUID

from fastapi import APIRouter, HTTPException, status

from {{ package_name }}.schemas import Item, ItemCreate

router = APIRouter(prefix="/items", tags=["items"])

_store: dict[UUID, Item] = {}


@router.post("", status_code=status.HTTP_201_CREATED)
def create_item(payload: ItemCreate) -> Item:
    item = Item(**payload.model_dump())
    _store[item.id] = item
    return item


@router.get("")
def list_items() -> list[Item]:
    return list(_store.values())


@router.get("/{item_id}")
def get_item(item_id: UUID) -> Item:
    if item_id not in _store:
        raise HTTPException(status.HTTP_404_NOT_FOUND, detail="item not found")
    return _store[item_id]


@router.delete("/{item_id}", status_code=status.HTTP_204_NO_CONTENT)
def delete_item(item_id: UUID) -> None:
    if _store.pop(item_id, None) is None:
        raise HTTPException(status.HTTP_404_NOT_FOUND, detail="item not found")

"""Storage boundary used by the example routes.

Replace this implementation with Postgres, DynamoDB, or another adapter. The
router depends on this small interface rather than on storage details.
"""

from uuid import UUID

from {{ package_name }}.schemas import Item, ItemCreate


class ItemRepository:
    """Small in-memory adapter suitable for tests and the starter app."""

    def __init__(self) -> None:
        self._items: dict[UUID, Item] = {}

    def create(self, payload: ItemCreate) -> Item:
        item = Item(**payload.model_dump())
        self._items[item.id] = item
        return item

    def list_items(self, *, offset: int = 0, limit: int = 50) -> list[Item]:
        return list(self._items.values())[offset : offset + limit]

    def get(self, item_id: UUID) -> Item | None:
        return self._items.get(item_id)

    def delete(self, item_id: UUID) -> bool:
        return self._items.pop(item_id, None) is not None

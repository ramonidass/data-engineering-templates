from functools import lru_cache

from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    """Runtime configuration, loaded from environment variables.

    Every field can be set as {{ package_name | upper }}__<FIELD>, e.g.
    {{ package_name | upper }}__LOG_LEVEL=DEBUG.
    """

    model_config = SettingsConfigDict(
        env_prefix="{{ package_name | upper }}__",
        env_file=".env",
        env_file_encoding="utf-8",
        extra="ignore",
    )

    app_name: str = "{{ product_name_display }}"
    environment: str = "local"
    log_level: str = "INFO"
    # Add service configuration here (database URLs, bucket names, ...).
    # Secrets arrive through the environment, never through code or defaults.


@lru_cache
def get_settings() -> Settings:
    return Settings()

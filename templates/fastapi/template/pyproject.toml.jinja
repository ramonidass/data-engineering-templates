[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ product_name_display }} API"
readme = "README.md"
requires-python = ">={{ python_version }}"
dependencies = [
    "fastapi>=0.141,<1",
    "uvicorn[standard]>=0.34",
    "pydantic>=2.13,<3",
    "pydantic-settings>=2.7",
]

[dependency-groups]
dev = [
    "pytest>=8.3",
    "pytest-cov>=6.0",
    "httpx2>=2.12,<3",
    "ruff>=0.16,<1",
    "mypy>=1.14",
    "pre-commit>=4.0",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.ruff]
line-length = {{ python_line_length }}
target-version = "py{{ python_version | replace('.', '') }}"
extend-exclude = [".venv", ".direnv"]

[tool.ruff.lint]
select = ["E", "F", "W", "I", "N", "UP", "B", "SIM", "PTH", "RUF"]

[tool.mypy]
strict = true
plugins = ["pydantic.mypy"]
exclude = ["\\.venv", "\\.direnv"]

[tool.pytest.ini_options]
addopts = "--cov=src --cov-report=term-missing"
testpaths = ["tests"]
